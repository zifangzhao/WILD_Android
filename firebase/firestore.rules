rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A fleet belongs to the Firebase Auth UID in its path. This lets the same
    // signed-in user see the fleet on a second phone without exposing it to
    // other Firebase users.
    match /fleets/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /fleets/{ownerUid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
